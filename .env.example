# Copy to .env and fill in real values. Never commit .env.

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-me
# Group/chat the bot works in (send /chatid to the bot to find it)
CHAT_ID=-1001234567890
# Optional forum topic for buyer message notifications
THREAD_ID=

# FunPay "golden_key" cookie from a logged-in browser session
GOLDEN_KEY=replace-me
# Optional overrides
# FUNPAY_USER_AGENT=
# STEAM_SUBCATEGORY_ID=89
# MAX_LOT_STOCK=3

POSTGRES_DB=funpay
POSTGRES_USER=funpay
POSTGRES_PASSWORD=change-me
# Use "localhost" when running the bot on the host; docker compose overrides it to "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Fernet key for encrypting stored passwords. Generate one with:
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes stored passwords unrecoverable.
ENCRYPTION_KEY=replace-me
